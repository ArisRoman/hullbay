// Schéma Prisma de l'ops-panel.
// RAPPEL : PostgreSQL est un CACHE de confort. La source de vérité redondante du
// désiré déployé vit dans les labels Docker bozando.* (voir @hullbay/shared).
// rebuildFromDocker() peut reconstruire ces tables depuis Docker seul.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // -> bozando.projectId / projectSlug
  description String?
  status      String   @default("draft") // draft | deployed | partial | error
  nodes       Node[]
  edges       Edge[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clusterId   String
  cluster     Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

model Node {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type String // container | network | volume | gateway
  name String // unique par projet -> bozando.nodeName

  // Position canvas (React Flow) -> bozando.canvas.x / y
  posX Float
  posY Float

  // Config typée selon `type` (validée par les schémas Zod de @hullbay/shared)
  // -> encodée dans bozando.spec
  config Json

  // ── Runtime observé (rempli par l'observer, NON source de vérité) ──
  dockerId    String? // containerId / networkId / nom de volume
  actualState String? // running | exited | created | missing | unknown ...
  desiredHash String? // -> bozando.desiredHash, diff idempotent

  edgesFrom Edge[] @relation("EdgeSource")
  edgesTo   Edge[] @relation("EdgeTarget")

  @@unique([projectId, name])
  @@index([projectId])
}

model Edge {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceNodeId String
  targetNodeId String
  source       Node   @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target       Node   @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  kind   String @default("network") // network | volume | gateway
  config Json?

  @@index([projectId])
}

// ── V2 : auth multi-utilisateur + audit ──
// Phase 2 (modèle identité) : les CRÉDENTIELLES vivent sur AuthIdentity (kind=local).
// User ne porte que ses attributs + ses memberships par tenant. `role` est un MIRROR
// temporaire (compat V1) — supprimé en fin de Phase 5B (le rôle réel = Membership.role).
model User {
  id        String   @id @default(cuid())
  email     String?  @unique // attribut, jamais identifiant primaire (iss+sub fait foi)
  name      String?
  locale    String?
  role      String   @default("owner") // MIRROR temporaire : owner | operator | viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities  AuthIdentity[]
  memberships Membership[]

  auditLogs AuditLog[]
  updates   SystemUpdate[]
}

// Une identité = un compte auprès d'UN provider (ou local). Un même User cumule :
// local + oidc + saml + ... (aucun provider privilégié). subject = sub OIDC /
// NameID SAML / stableAttr LDAP / "local:<userId>".
model AuthIdentity {
  id           String   @id @default(cuid())
  userId       String
  providerId   String   // id du provider (voir AuthProvider / seeds registry)
  kind         String   // local | oidc | oauth2 | saml | ldap
  issuer       String?  // obligatoire pour oidc/saml ; NULL pour local/ldap-bind
  subject      String
  email        String?

  // Crédenciales locales uniquement (kind=local)
  passwordHash String?
  mfaSecretEnc String? // secret TOTP chiffré (AES-256-GCM, scope "mfa")
  mfaEnabled   Boolean  @default(false)

  createdAt   DateTime @default(now())
  lastLoginAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, issuer, subject])
  @@index([userId])
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships Membership[]
}
// Phase 5B : + clusters/settings/auditLogs/projects (tenant-scopés) — §4.4 du plan.

// Rôle = propriété de la MEMBERSHIP, pas du User. Phase 2 : tenant par défaut unique.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   // owner | operator | viewer
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

// Providers d'authentification. id généré — JAMAIS de défaut vendor (correction N°4).
// local est un provider comme les autres ; oidc/saml/ldap ne sont que des
// configurations de protocole (aucune intégration vendor : correction N°7).
model AuthProvider {
  id        String   @id @default(cuid())
  kind      String   // local | oidc | oauth2 | saml | ldap
  name      String   // nom libre : "Entra Corp", "Company LDAP", "Local"...
  enabled   Boolean  @default(false)
  config    Json     @default("{}") // champs sensibles CHIFFRÉS individuellement (§8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// Phase 5B : + tenantId String? (null = provider global) — §4.2, correction N°22.

// Identité inconnue d'un provider → ligne "pending" (jamais de User créé en auto).
// Le workflow d'approbation effectif (owner → User + AuthIdentity + Membership)
// est livré en Phase 5A (correction N°20). Phase 2 : tableau prête, remplie en 3/4.
model PendingIdentity {
  id                   String   @id @default(cuid())
  providerId           String
  issuer               String?
  subject              String
  email                String?
  name                 String?
  requestedForTenantId String?
  status               String   @default("pending") // pending | approved | rejected
  createdAt            DateTime @default(now())

  @@unique([providerId, issuer, subject])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // deploy | destroy | rebuild | server.provisioned | ...
  projectId String?
  nodeId    String?
  serverId  String?
  ip        String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// ── Serveurs physiques du cluster Swarm (provisioning SSH one-shot) ──
model Server {
  id            String   @id @default(cuid())
  name          String
  host          String
  port          Int      @default(22)
  user          String   @default("root")
  role          String // manager | worker
  status        String   @default("provisioning") // provisioning | ready | error | draining | down
  swarmNodeId   String? // ID du nœud dans Swarm
  // Clé OUTIL (générée par l'app) privée chiffrée AES-256-GCM. JAMAIS la clé perso de l'utilisateur.
  privateKeyEnc String?
  publicKey     String? // clé-outil publique (déposée dans authorized_keys)
  hostKeyFp     String? // empreinte SSH connue (TOFU known_hosts)
  lastError     String?
  systemInfo   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clusterId     String
  cluster       Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

// ── Credentials de registre Docker (GHCR) — pour pull sur chaque nœud ──
model RegistryCredential {
  id        String   @id @default(cuid())
  registry  String   @default("ghcr.io")
  username  String
  tokenEnc  String // token/password chiffré AES-256-GCM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Parametre systeme - domaine public configurable ──
model Settings {
  id          String @id @default("singleton")
  domain      String?
  updatedAt   DateTime @updatedAt
}

// ── Cluster Docker swarm (TON TRAVAIL) ──
model Cluster {
  id            String @id @default(cuid())
  name          String @unique
  dockerHost    String
  caddyAdminUrl String
  isDefault     Boolean @default(false)
  status        String   @default("pending")
  deletingAt    DateTime?
  servers       Server[]
  projects      Project[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


// ── Mises à jour du système (instances auto-hébergées, style Coolify) ──
// SystemInfo : singleton reflétant l'état courant de l'installation.
// currentVersion est seedé au boot depuis l'env IMAGE_TAG (source de vérité déployée).
model SystemInfo {
  id              String    @id @default("singleton")
  currentVersion  String    @default("unknown")
  updateChannel   String    @default("stable") // stable | beta
  lastCheckAt     DateTime?
  lastCheckResult Json?
  // Audit des changements de canal : [{ at, from, to }], dernier au début (max 10).
  channelHistory  Json      @default("[]")
  updatedAt       DateTime  @updatedAt
}

// Un historique de mise à jour : une entrée par apply/rollback.
// steps/logs : JSON array, persistés pour traçabilité post-mortem (le process API
// meurt pendant l'update de lui-même — la finalisation a lieu au boot suivant).
model SystemUpdate {
  id            String      @id @default(cuid())
  status        String      @default("pending") // pending | running | success | failed | rolled_back
  fromVersion   String
  toVersion     String
  channel       String      @default("stable")
  steps         Json        @default("[]")
  logs          Json        @default("[]")
  error         String?
  // Rollback : l'update d'origine réussie est marquée rolledBack une fois annulée ;
  // le rollback crée un NOUVEL enregistrement (rollbackOfId → l'update source).
  rolledBack    Boolean     @default(false)
  rollbackOfId  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  triggeredById String?
  triggeredBy   User?       @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([rollbackOfId])
}